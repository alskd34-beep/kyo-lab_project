# ─────────────────────────────────────────────────────────────────────────────
# 환경변수 템플릿 — 이 파일을 `.env.local` 로 복사해서 실제 값을 채우세요.
#
# ⚠️ `.env.local` 은 절대 커밋하지 마세요. (.gitignore 의 `.env*.local` 규칙)
#    2026-08-23 점검에서 `.env.local` 이 3개 커밋에 걸쳐 추적되고 있던 것을 발견해
#    `git rm --cached` 로 추적을 해제했습니다. 히스토리에는 여전히 남아 있으므로
#    아래 키들은 전부 재발급/로테이션 대상입니다.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# 서버는 service-role 키로만 DB 에 접근합니다(anon 폴백은 보안상 제거됨).
# 이 키가 없으면 서버가 부팅 시점에 실패합니다 — 의도된 동작입니다.
SUPABASE_SERVICE_ROLE_KEY=

# 마이그레이션 스크립트(scripts/migrate.ts)용
SUPABASE_DB_PASSWORD=

# ─── JWT (인증) ──────────────────────────────────────────────────────────────
# 반드시 32바이트 이상 랜덤값. 생성: openssl rand -hex 32
# 미설정 시 개발용 기본값으로 폴백하므로 운영에서는 반드시 지정하세요.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ─── 부트스트랩 관리자 (1회성 시드) ──────────────────────────────────────────
# `npx tsx scripts/seed_admin.ts` 실행 시에만 사용됩니다.
# 예전에는 kyo-admin/kyo-admin 이 소스에 하드코딩된 채 공개 로그인 엔드포인트에서
# 요청마다 자동 시드됐습니다(2026-08-23 제거). 비밀번호는 12자 이상이어야 합니다.
# 시드 후에는 이 변수를 비워두세요.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=


# ─── 챗봇: Letsur (관리자 역할, 운영) ────────────────────────────────────────
LETSUR_BASE_URL=
LETSUR_API_KEY=
# 운영 기준 모델. 최대 3만자의 QC 데이터 컨텍스트를 읽어야 하므로 구형 mini 급은 피한다.
LETSUR_MODEL=gpt-5-mini

# 추론 강도: minimal | low | medium | high | off (기본 low)
# QC 조회 답변은 깊은 추론이 필요 없고 지연이 곧 체감 품질이다.
# 추론을 지원하지 않는 모델로 바꾸면 off (미지원 오류 시 자동으로 1회 재시도하긴 한다).
LETSUR_REASONING_EFFORT=low

# 응답 타임아웃(ms). 기본 180000.
# 답변은 완성된 뒤에야 사용자에게 전달되므로 타임아웃이 곧 빈 말풍선이 된다.
LETSUR_TIMEOUT_MS=180000

# ─── 챗봇: CLI (관리자 역할, 개발) ───────────────────────────────────────────
# 미설정 시 비프로덕션에서 CLI 경로가 기본 활성화됩니다.
# 운영에서는 반드시 0 으로 두고 Letsur 를 쓰세요(CLI 는 감사추적이 남지 않습니다).
CHAT_ADMIN_USE_CLI=0

# CLI 제공자: codex(기본, GPT) | claude
CHAT_ADMIN_CLI_PROVIDER=codex

# Codex(GPT) CLI — 서버에 설치 + 로그인(구독)되어 있어야 합니다.
# CODEX_EXEC_PATH        : 실행 파일 절대경로 오버라이드. 미설정 시 자동 탐색
#                          (VS Code 확장의 현재 플랫폼 바이너리 → PATH → npm 전역 bin/codex.js).
# CODEX_ASSISTANT_MODEL  : 미설정 시 Codex 계정의 기본 모델.
CODEX_EXEC_PATH=
CODEX_MODEL=
CODEX_ASSISTANT_MODEL=

# 이 경로는 구독 세션으로 무과금 사용하는 것이 목적이라, 자식 프로세스에
# OPENAI_API_KEY 를 물려주지 않습니다(키가 있으면 구독 대신 키 과금).
# 일부러 API 키로 붙이려면 1 로 설정하세요.
CODEX_USE_API_KEY=0

# 레거시: 셸 명령 문자열(POSIX 전용). 설정 시 CODEX_EXEC_PATH 대신 셸 경로를 씁니다.
# Windows 에서는 동작하지 않으므로 비워 두세요.
CODEX_EXEC_CMD=

# Claude CLI — CHAT_ADMIN_CLI_PROVIDER=claude 일 때만 쓰입니다.
CLAUDE_EXEC_PATH=
CLAUDE_ASSISTANT_MODEL=
CLAUDE_USE_API_KEY=0

# ─── AI 자동배정 (옵트인) ────────────────────────────────────────────────────
# 1 이면 Codex CLI 로 배분을 시도하고 실패 시 규칙엔진으로 폴백합니다.
# LLM 경로는 역량/장비/듀오 제약을 강제하지 않으므로 운영 사용 전 검증이 필요합니다.
ENABLE_CODEX_ASSIGN=0

# ─── PCT 구글시트 적재 ───────────────────────────────────────────────────────
GOOGLE_SHEETS_PCT_FILE_ID=
# 1 이면 node-cron 자동 적재(09:00 / 14:00 KST)를 비활성화합니다.
DISABLE_PCT_CRON=

# ─── 사내망 전용 접근 제한 (클라우드 배포 시 필수) ───────────────────────────
# Railway 는 서비스를 공개 URL 로만 노출한다. 네트워크 수준 차단 기능이 없으므로
# 앱 앞단(`middleware.ts`)에서 발신 IP 를 걸러 "사내에서만 접속" 을 만든다.
#
# 쉼표로 구분. 단일 IP · IPv4 CIDR · `*`(전체 허용) 를 쓸 수 있다.
#   예) IP_ALLOWLIST=203.0.113.7,203.0.113.0/24
#
# ⚠️ NODE_ENV=production 인데 비어 있으면 **모든 접근이 차단된다**(fail-closed).
#    설정 누락이 곧 전면 공개가 되지 않게 한 의도된 동작이다.
#    로컬(비운영)에서 비어 있으면 검사를 건너뛴다.
#
# 사내 공인 IP 확인: 사내망 PC 에서 `curl ifconfig.me`
IP_ALLOWLIST=

# 서버 포트. Railway 가 주입하므로 클라우드에서는 설정하지 않는다.
# (로컬에서 운영 빌드를 3300 으로 띄우려면 `npm run start:local`)
PORT=

# 앞단 프록시가 "실제 발신 IP" 만 담는 전용 헤더를 쓸 때 그 헤더 이름.
# 비워 두면 `x-forwarded-for` 의 맨 오른쪽 값을 쓴다(프록시가 덧붙인 값 = 위조 불가).
# 배포 후 검증에서 위조가 통과하면 앞단에 Cloudflare 를 두고 cf-connecting-ip 로 바꾼다.
#   예) IP_CLIENT_HEADER=cf-connecting-ip
IP_CLIENT_HEADER=
